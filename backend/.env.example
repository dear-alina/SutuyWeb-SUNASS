# Copie este archivo como backend/.env y reemplace los valores. Nunca suba backend/.env.
# En local, los valores salen de: npx supabase status -o env  (desde la carpeta bd/)

PUERTO=4000

# API_URL de Supabase
SUPABASE_URL=http://127.0.0.1:54321
# PUBLISHABLE_KEY (o ANON_KEY): se usa para iniciar y renovar sesiones
SUPABASE_CLAVE_PUBLICA=sb_publishable_valor-ficticio-reemplazar
# SECRET_KEY (o SERVICE_ROLE_KEY): solo para la Admin API de Auth. Es secreta.
SUPABASE_CLAVE_SECRETA=sb_secret_valor-ficticio-reemplazar
# DB_URL: conexión directa a PostgreSQL con un rol de servidor
DATABASE_URL=postgresql://postgres:clave-ficticia@127.0.0.1:54322/postgres

# Orígenes del frontend permitidos (CORS y CSRF), separados por comas
ORIGENES_PERMITIDOS=http://localhost:3000
# true salvo en un entorno que no acepte cookies Secure por http
COOKIE_SEGURA=true

# Solo para demostraciones en local: clave de las cuentas demo (npm run crear-cuentas-demo).
# Debe coincidir con NEXT_PUBLIC_CLAVE_DEMO del frontend. Nunca la suba ni la use en el proyecto compartido sin acordarlo.
CLAVE_DEMO=
