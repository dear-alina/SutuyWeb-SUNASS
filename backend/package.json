{
  "name": "sutuyweb-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API de SutuyWeb: sesiones, perfiles y solicitudes de acceso",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch-path=src src/servidor.js",
    "start": "node --env-file=.env src/servidor.js",
    "test": "vitest run",
    "openapi": "node scripts/generar-openapi.js",
    "crear-admin": "node --env-file=.env scripts/crear-admin.js",
    "crear-cuentas-demo": "node --env-file=.env scripts/crear-cuentas-demo.js"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@supabase/supabase-js": "2.119.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "supertest": "7.3.2",
    "vitest": "5.1.2"
  }
}
