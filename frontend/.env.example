# Copie este archivo como .env.local. Solo valores que no son secretos (NEXT_PUBLIC_*).
# URL del backend en desarrollo; la sesión viaja en cookies HttpOnly que fija la API.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Modo demostración, SOLO en local: el ingreso muestra un selector de cuentas demo con la clave rellena.
# NEXT_PUBLIC_MODO_DEMO usa el backend; NEXT_PUBLIC_DEMO_SIN_BACKEND usa usuarios del navegador (src/demo/).
# Los valores NEXT_PUBLIC_* quedan en el código que descarga el navegador: nunca activarlo en un despliegue público.
# La clave debe coincidir con CLAVE_DEMO de backend/.env (npm run crear-cuentas-demo).
NEXT_PUBLIC_MODO_DEMO=false
NEXT_PUBLIC_DEMO_SIN_BACKEND=false
NEXT_PUBLIC_CLAVE_DEMO=
